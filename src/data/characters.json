{
  "$schema": "../../schemas/characters.schema.json",
  "_help": "Every character a pet can grow into. See docs/ART_GUIDE.md. 'stages' lists the sheet used by every egg, baby and teen. Each adult character has a theme, a star rarity (1 = common, 3 = rare) and a sprite sheet from public/sprites/manifest.json. 'variants' are optional colour versions: each has its own sheet and a chance (in percent) of appearing; otherwise the pet uses the character's normal sheet. Adding a character is one new entry here plus its sheet in the manifest. 'traits' (optional) lists the only traits a pet of this character can have, e.g. \"traits\": [\"grumpy\", \"sleepy\"]: a pet that grows into it keeps its trait if it's listed and otherwise gets one from the list. Traits marked 'special' in src/data/traits.json only go to characters that list them. 'elements' never change: every theme belongs to one of them, listed in 'themeElements' (a new theme joins one). 'laterPacks' lists themes that aren't out yet: pets that already have one of their characters keep it, but no new pet (or wanderer) grows into one.",
  "stages": {
    "egg": "egg",
    "baby": "baby",
    "teen": "teen"
  },
  "themes": {
    "nature": "Nature",
    "ocean": "Ocean",
    "bakery": "Bakery",
    "starry": "Starry",
    "cave": "Cave"
  },
  "elements": {
    "land": "Land",
    "water": "Water",
    "sky": "Sky",
    "hearth": "Hearth"
  },
  "themeElements": {
    "nature": "land",
    "cave": "land",
    "ocean": "water",
    "starry": "sky",
    "bakery": "hearth"
  },
  "characters": [
    { "id": "sprig", "theme": "nature", "stars": 1, "name": "Sprig", "sheet": "sprig",
      "variants": [{ "id": "autumn", "name": "Autumn", "sheet": "sprig-autumn", "chance": 10 }] },
    { "id": "acornet", "theme": "nature", "stars": 2, "name": "Acornet", "sheet": "acornet" },
    { "id": "stumpy", "theme": "nature", "stars": 3, "name": "Stumpy", "sheet": "stumpy",
      "traits": ["shy", "sleepy"] },
    { "id": "bubbit", "theme": "ocean", "stars": 1, "name": "Bubbit", "sheet": "bubbit" },
    { "id": "jellop", "theme": "ocean", "stars": 2, "name": "Jellop", "sheet": "jellop" },
    { "id": "tidecrest", "theme": "ocean", "stars": 3, "name": "Tidecrest", "sheet": "tidecrest",
      "traits": ["playful", "cheery"] },
    { "id": "dumpling", "theme": "bakery", "stars": 1, "name": "Dumpling", "sheet": "dumpling",
      "variants": [{ "id": "matcha", "name": "Matcha", "sheet": "dumpling-matcha", "chance": 10 }] },
    { "id": "puddling", "theme": "bakery", "stars": 2, "name": "Puddling", "sheet": "puddling" },
    { "id": "cuppie", "theme": "bakery", "stars": 3, "name": "Cuppie", "sheet": "cuppie",
      "traits": ["greedy", "cheery"] },
    { "id": "cloudlet", "theme": "starry", "stars": 1, "name": "Cloudlet", "sheet": "cloudlet" },
    { "id": "moonpip", "theme": "starry", "stars": 2, "name": "Moonpip", "sheet": "moonpip",
      "variants": [{ "id": "dawn", "name": "Dawn", "sheet": "moonpip-dawn", "chance": 10 }] },
    { "id": "starhoot", "theme": "starry", "stars": 3, "name": "Starhoot", "sheet": "starhoot",
      "traits": ["sleepy"] },
    {
      "id": "pebblit",
      "theme": "cave",
      "stars": 1,
      "name": "Pebblit",
      "sheet": "pebblit",
      "variants": [
        {
          "id": "amber",
          "name": "Amber",
          "sheet": "pebblit-amber",
          "chance": 25
        }
      ]
    },
    { "id": "crystalback", "theme": "cave", "stars": 2, "name": "Crystalback", "sheet": "crystalback",
      "variants": [{ "id": "rose", "name": "Rose Quartz", "sheet": "crystalback-rose", "chance": 10 }] },
    { "id": "geodon", "theme": "cave", "stars": 3, "name": "Geodon", "sheet": "geodon" }
  ],
  "laterPacks": [
    "cave"
  ]
}
