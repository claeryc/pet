"idle": [0, -1, -1, 0],
"sad": [1, 1, 2, 1],
"sleep": [1, 2, 2, 1],
"sick": [0, 0, 0, 0],
"eat": [0, 1, 0, 1],
"happy": [0, -2, -2, -1],
"cheerful": [0, 0, -1, 0]
}
head_shifts = {
"idle": [0, 0, 0, 0],
"sad": [0, 0, 0, 0],
"sleep": [0, 0, 0, 0],
"sick": [0, -1, 0, 1],
"eat": [0, 0, 0, 0],
"happy": [0, 0, 0, 0],
"cheerful": [0, 0, 0, 0]
}
idle_moves = PackedStringArray()
